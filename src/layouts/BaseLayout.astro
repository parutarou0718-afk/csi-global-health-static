---
import "../styles/global.css"; import { site, type Lang } from "../data/site"; import Header from "../components/Header.astro"; import Footer from "../components/Footer.astro";
const {lang,title=site.company}=Astro.props as {lang:Lang;title?:string};
---
<!doctype html><html lang={lang==="zh"?"zh-CN":lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="CSI Global Health — university-based biomedical innovation platform."/><title>{title}</title></head><body><Header lang={lang} pathname={Astro.url.pathname}/><main><slot/></main><Footer lang={lang}/></body></html>
