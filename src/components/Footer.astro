---
import { companyContact, companyProfile } from "../data/company";
import { navigation as enNavigation } from "../i18n/en";
import { navigation as jaNavigation } from "../i18n/ja";
import type { Lang } from "../lib/i18n";

const { lang } = Astro.props as { lang: Lang };
const navigation = lang === "en" ? enNavigation : jaNavigation;
const contactHeading = lang === "en" ? "Contact" : "お問い合わせ";
const navigationHeading = lang === "en" ? "Navigation" : "ナビゲーション";
const placeholderNote = lang === "en"
  ? "Public contact details are being confirmed."
  : "公開連絡先情報は確認中です。";
const hasVerifiedContact = Object.values(companyContact).some((item) => item.status === "verified");
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="footer-brand" href={`/${lang}/`}>
        <img src="/assets/csi-mark.png" alt="" />
        <span>
          <strong>{companyProfile.name}</strong>
          <small>{companyProfile.tagline[lang]}</small>
        </span>
      </a>
    </div>
    <div>
      <h2>{navigationHeading}</h2>
      <nav aria-label="Footer navigation">
        {navigation.map(([label, href]) => <a href={href}>{label}</a>)}
      </nav>
    </div>
    <div>
      <h2>{contactHeading}</h2>
      {hasVerifiedContact ? (
        <ul>
          {Object.values(companyContact).filter((item) => item.status === "verified").map((item) => (
            <li>{item.label[lang]}: {item.value[lang]}</li>
          ))}
        </ul>
      ) : <p>{placeholderNote}</p>}
    </div>
  </div>
  <div class="container footer-legal">© {new Date().getFullYear()} {companyProfile.name}. All rights reserved.</div>
</footer>
