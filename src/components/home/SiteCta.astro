---
import { homeContent } from "../../data/home";
import type { Lang } from "../../lib/i18n";

const { lang } = Astro.props as { lang: Lang };
const { cta } = homeContent[lang];
---
<section class="home-cta">
  <div class="container home-cta__inner">
    <div><h2>{cta.title}</h2><p>{cta.body}</p></div>
    <a class="button button--primary" href={`/${lang}/contact/`}>{cta.label}<span aria-hidden="true">→</span></a>
  </div>
</section>
