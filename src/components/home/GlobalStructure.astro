---
import { homeContent } from "../../data/home";
import type { Lang } from "../../lib/i18n";

const { lang } = Astro.props as { lang: Lang };
const { globalHeading, globalStructure } = homeContent[lang];
---
<section class="home-global section">
  <div class="container">
    <div class="section-heading"><p class="eyebrow">CSI Global Health</p><h2>{globalHeading}</h2></div>
    <div class="home-global__grid">
      {globalStructure.map((item, index) => (
        <article class="global-card">
          <span>{String(index + 1).padStart(2, "0")}</span>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
