---
import { okayamaBnctContent } from "../../data/okayama-bnct";
import type { Lang } from "../../lib/i18n";

const { lang } = Astro.props as { lang: Lang };
const about = okayamaBnctContent[lang];
---
<section class="home-about section">
  <div class="container">
    <div class="home-about__panel">
      <div class="home-about__identity">
        <img src="/assets/okayama-university.svg" alt={lang === "en" ? "Okayama University" : "岡山大学"} width="280" height="126" loading="lazy" />
      </div>
      <div class="home-about__copy">
        <h2>{about.title}</h2>
        {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <ul class="home-about__themes" aria-label={lang === "en" ? "Research themes" : "研究テーマ"}>
        {about.themes.map((theme) => (
          <li>
            <img src={theme.icon} alt={theme.alt} width="72" height="72" loading="lazy" />
            <strong>{theme.title}</strong>
            <span>{theme.subtitle}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
