---
import { homeContent } from "../../data/home";
import type { Lang } from "../../lib/i18n";

const { lang } = Astro.props as { lang: Lang };
const { about } = homeContent[lang];
---
<section class="home-about section">
  <div class="container">
    <div class="home-about__panel">
      <div class="home-about__copy">
        <p class="eyebrow">CSI Global Health</p>
        <h2>{about.title}</h2>
        <p>{about.body}</p>
        <a class="text-link" href={`/${lang}/about/`}>{about.linkLabel}<span aria-hidden="true"> →</span></a>
      </div>
      <div class="home-about__identity">
        <img src="/assets/okayama-university.svg" alt={lang === "en" ? "Okayama University" : "岡山大学"} width="280" height="126" loading="lazy" />
      </div>
    </div>
  </div>
</section>
