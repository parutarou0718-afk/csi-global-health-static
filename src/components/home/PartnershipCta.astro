---
import { homeContent } from "../../data/home";
import type { Lang } from "../../lib/i18n";

const { lang } = Astro.props as { lang: Lang };
const { partnership } = homeContent[lang];
---
<section class="home-partnership section">
  <div class="container">
    <div class="home-partnership__grid">
      <div>
        <p class="eyebrow">CSI Global Health</p>
        <h2>{partnership.title}</h2>
        <p>{partnership.body}</p>
      </div>
      <ul class="home-partnership__areas">
        {partnership.areas.map((area) => <li>{area}</li>)}
      </ul>
    </div>
    <a class="button button--primary" href={`/${lang}/contact/`}>{partnership.label}<span aria-hidden="true"> →</span></a>
  </div>
</section>
