---
import { experts } from "../../data/experts";
import { homeContent } from "../../data/home";
import type { Lang } from "../../lib/i18n";

const { lang } = Astro.props as { lang: Lang };
const portraits: Record<string, string> = {
  "eiji-matsuura": "/assets/eiji-matsuura.jpg",
  "wolfgang-sauerwein": "/assets/wolfgang-sauerwein.jpg",
  "sylviane-muller": "/assets/sylviane-muller.jpg",
  "rameshwar-patil": "/assets/rameshwar-patil.jpg",
};
const linkLabel = lang === "en" ? "View all experts" : "専門家一覧を見る";
---
<section class="home-experts section">
  <div class="container">
    <div class="section-heading"><p class="eyebrow">CSI Global Health</p><h2>{homeContent[lang].expertHeading}</h2></div>
    <div class="home-experts__grid">
      {experts.map((expert) => (
        <article class="expert-card">
          <img src={portraits[expert.slug]} alt={expert.name} width="240" height="240" loading="lazy" />
          <div>
            <h3>{expert.name}</h3>
            <p class="expert-card__institution">{expert.institution[lang]}</p>
            <p>{expert.focus[lang]}</p>
          </div>
        </article>
      ))}
    </div>
    <a class="text-link" href={`/${lang}/experts/`}>{linkLabel}<span aria-hidden="true"> →</span></a>
  </div>
</section>
