---
import { homeContent } from "../../data/home";
import { newsItems } from "../../data/news";
import type { Lang } from "../../lib/i18n";

const { lang } = Astro.props as { lang: Lang };
const { news } = homeContent[lang];
const latest = newsItems[0];
---
<section class="home-news section">
  <div class="container">
    <div class="section-heading"><p class="eyebrow">CSI Global Health</p><h2>{news.title}</h2></div>
    {latest ? <a class="home-news__item" href={`/${lang}/news/${latest.slug}/`}>
      <img src={latest.image} alt="" />
      <div>
        <h3>{latest.title[lang]}</h3>
        <p>{latest.summary[lang]}</p>
        <span class="text-link">{news.linkLabel}<span aria-hidden="true"> →</span></span>
      </div>
    </a> : <div class="home-news__empty">
      <div>
        <h3>{news.emptyTitle}</h3>
        <p>{news.emptyBody}</p>
      </div>
      <a class="button button--quiet" href={`/${lang}/news/`}>{news.linkLabel}<span aria-hidden="true"> →</span></a>
    </div>}
  </div>
</section>
