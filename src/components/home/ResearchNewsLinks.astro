---
import { homeContent } from "../../data/home";
import type { Lang } from "../../lib/i18n";

const { lang } = Astro.props as { lang: Lang };
const { researchHeading, researchLinks } = homeContent[lang];
---
<section class="home-research section">
  <div class="container">
    <div class="section-heading"><p class="eyebrow">CSI Global Health</p><h2>{researchHeading}</h2></div>
    <div class="home-research__grid">
      {researchLinks.map((item, index) => (
        <a class="research-card" href={item.href}>
          <img src="/images/news/placeholder.svg" alt="" width="1200" height="675" loading="lazy" />
          <div><span>{String(index + 1).padStart(2, "0")}</span><h3>{item.title}</h3><p>{item.body}</p><b>{lang === "en" ? "View details" : "詳細を見る"} →</b></div>
        </a>
      ))}
    </div>
  </div>
</section>
