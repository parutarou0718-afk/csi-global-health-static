---
import { home, type Lang } from "../data/site"; const { lang }=Astro.props as {lang:Lang}; const t=home[lang];
---
<section class="hero"><div class="hero-copy"><div class="eyebrow">{t.eyebrow}</div><h1>{t.hero1}<br/><span>{t.hero2}</span></h1><h2><em>{t.hero3a}</em>{t.hero3b}</h2><p>{t.intro}</p><a class="btn red" href={`/${lang}/about/`}>{t.learn} →</a></div><div class="world-visual"><svg viewBox="0 0 600 330" role="img"><title>{lang==="ja"?"日本と米国を結ぶグローバル研究ネットワーク":lang==="zh"?"连接日本、美国与全球的科研网络":"Global research network linking Japan and the United States"}</title><ellipse cx="310" cy="165" rx="260" ry="115" fill="none" stroke="currentColor" opacity=".15"/><path d="M120 95Q280 35 400 160M200 230Q320 95 485 125" fill="none" stroke="currentColor" opacity=".35"/><circle cx="398" cy="160" r="9" fill="#d71936"/><circle cx="505" cy="115" r="7" fill="#0b62b0"/><circle cx="190" cy="85" r="7" fill="#0b62b0"/><circle cx="280" cy="205" r="7" fill="#0b62b0"/><text x="410" y="155">Japan</text><text x="515" y="110">USA</text><text x="145" y="78">Europe</text><text x="230" y="225">China / Asia</text></svg></div></section>
