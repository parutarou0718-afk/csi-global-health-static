---
import { navigation as enNavigation } from "../i18n/en";
import { navigation as jaNavigation } from "../i18n/ja";
import { pagePath, supportedLanguages, type Lang } from "../lib/i18n";

const { lang, pathname } = Astro.props as { lang: Lang; pathname: string };
const navigation = lang === "en" ? enNavigation : jaNavigation;
const menuLabel = lang === "en" ? "Open navigation" : "ナビゲーションを開く";
---

<div class="mobile-nav">
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-primary-navigation">
    <span aria-hidden="true">☰</span><span class="sr-only">{menuLabel}</span>
  </button>
  <nav id="mobile-primary-navigation" class="site-nav site-nav--mobile" aria-label="Primary navigation" hidden>
    {navigation.map(([label, href]) => <a class:list={{ active: pathname === href }} href={href}>{label}</a>)}
    <div class="mobile-language-switcher" aria-label="Language switcher">
      {supportedLanguages.map((target) => (
        <a aria-current={target === lang ? "page" : undefined} href={pagePath(target, pathname)}>{target.toUpperCase()}</a>
      ))}
    </div>
  </nav>
</div>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const navigation = document.querySelector<HTMLElement>("#mobile-primary-navigation");

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") !== "true";
    toggle.setAttribute("aria-expanded", String(open));
    if (navigation) navigation.hidden = !open;
  });
</script>
