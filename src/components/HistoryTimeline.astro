---
import { home, type Lang } from "../data/site";

const { lang } = Astro.props as { lang: Lang };
const t = home[lang];
---

<section class="section history-section">
  <div class="section-heading">
    <span>OUR FOUNDATION</span>
    <h2 class="section-title">{t.historyTitle}</h2>
  </div>
  <ol class="timeline-card">
    {t.steps.map(([n, title, desc], index) => (
      <li class="step">
        <div class="step-top">
          <span>{n}</span>
          {index === 0 && <img src="/assets/okayama-university.svg" alt="Okayama University" />}
          {index === 1 && <img class="timeline-company-mark" src="/assets/csi-mark.png" alt="CSI Global Health" />}
          {index === 2 && <div class="timeline-flags" aria-label="Japan and United States">🇯🇵 <span aria-hidden="true">•</span> 🇺🇸</div>}
          {index === 3 && <div class="timeline-globe" aria-hidden="true">◎</div>}
        </div>
        <h3>{title}</h3>
        <p>{desc}</p>
      </li>
    ))}
  </ol>
</section>
