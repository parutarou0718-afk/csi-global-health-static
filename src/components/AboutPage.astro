---
import { companyFacts, companyProfile } from "../data/company";
import { experts } from "../data/experts";
import { about as enAbout } from "../i18n/en";
import { about as jaAbout } from "../i18n/ja";
import type { Lang } from "../lib/i18n";

const { lang } = Astro.props as { lang: Lang };
const copy = lang === "en" ? enAbout : jaAbout;
const founder = experts.find((expert) => expert.slug === "eiji-matsuura");
const networkImages = ["/images/about/network-japan.png", "/images/about/network-usa.png", "/images/about/network-global.png"];
const strategyIcons = ["/images/about/strategy-icons/particle-medicine.png", "/images/about/strategy-icons/translation-technology.png", "/images/about/strategy-icons/global-collaboration.png"];
const profileRows = [
  [copy.profile.name, companyProfile.name],
  [copy.profile.established, companyFacts.established[lang]],
  [copy.profile.representative, companyFacts.representative[lang]],
  [copy.profile.positioning, companyFacts.positioning[lang]],
  [copy.profile.business, companyFacts.business[lang]],
] as const;
---

<section class="about-hero">
  <div class="container about-hero__grid">
    <div class="about-hero__copy">
      <p class="eyebrow">{copy.hero.eyebrow}</p>
      <h1>{copy.hero.title}</h1>
      <p class="about-hero__headline">{copy.hero.headline}</p>
      <p>{copy.hero.description}</p>
    </div>
    <div class="about-hero__visual">
      <img class="about-hero__city" src="/images/about/about-hero-okayama.jpg" alt={copy.hero.cityAlt} />
      <img class="about-hero__globe" src="/images/about/about-hero-globe.jpg" alt={copy.hero.globeAlt} />
    </div>
  </div>
</section>

<section class="about-who section"><div class="container about-two-column">
  <div><p class="eyebrow">{copy.who.label}</p><h2>{copy.who.title}</h2><p class="about-section-lead">{copy.who.description}</p></div>
  <ul class="about-themes" aria-label={copy.who.label}>{copy.who.themes.map(([title, detail]) => <li><strong>{title}</strong><span>{detail}</span></li>)}</ul>
</div></section>

<section class="about-foundation section"><div class="container about-foundation__grid">
  <div class="about-foundation__visual"><img src="/images/about/about-foundation-okayama.jpg" alt="Okayama University campus" /></div>
  <div><p class="eyebrow">{copy.foundation.label}</p><h2>{copy.foundation.title}</h2><p class="about-section-lead">{copy.foundation.description}</p>
  <ol class="about-foundation__path">{copy.foundation.steps.map((step) => <li>{step}</li>)}</ol></div>
</div></section>

<section class="about-founder section"><div class="container about-founder__grid">
  <img src="/assets/eiji-matsuura.jpg" alt={founder?.name ?? "Eiji Matsuura"} />
  <div><p class="eyebrow">{copy.founder.label}</p><h2>{copy.founder.title}</h2><p class="about-founder__role">{founder?.role?.[lang]}</p><p class="about-founder__message">{copy.founder.message}</p><a class="text-link" href={`/${lang}/experts/`}>{copy.founder.link} <span aria-hidden="true">→</span></a></div>
</div></section>

<section class="about-strategy section"><div class="container">
  <p class="eyebrow">{copy.strategy.label}</p><h2>{copy.strategy.title}</h2>
  <div class="about-strategy__grid">{copy.strategy.items.map(([title, keywords, description], index) => <article class="about-strategy__item"><img class="about-strategy__icon" src={strategyIcons[index]} alt="" /><h3>{title}</h3><p class="about-strategy__keywords">{keywords}</p><p>{description}</p></article>)}</div>
  <a class="text-link" href={`/${lang}/business/`}>{copy.strategy.link} <span aria-hidden="true">→</span></a>
</div></section>

<section class="about-network section"><div class="container">
  <p class="eyebrow">{copy.network.label}</p><h2>{copy.network.title}</h2>
  <ol class="about-network__flow">{companyFacts.network.map((node, index) => <li><img src={networkImages[index]} alt="" /><p class="about-network__region">{node.title[lang]}</p><h3>{typeof node.name === "string" ? node.name : node.name[lang]}</h3><p>{node.description[lang]}</p></li>)}</ol>
</div></section>

<section class="about-vision section"><div class="container about-vision__inner"><p class="eyebrow">{copy.vision.label}</p><h2>{copy.vision.title}</h2><p>{copy.vision.description}</p></div></section>

<section class="about-profile section"><div class="container about-profile__inner"><p class="eyebrow">{copy.profile.label}</p><h2>{copy.profile.title}</h2><dl class="about-profile__list">{profileRows.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></div></section>

<section class="about-cta section"><div class="container about-cta__inner"><a class="button button--primary" href={`/${lang}/business/`}>{copy.cta.business} <span aria-hidden="true">→</span></a><a class="button button--secondary" href={`/${lang}/experts/`}>{copy.cta.experts} <span aria-hidden="true">→</span></a></div></section>
