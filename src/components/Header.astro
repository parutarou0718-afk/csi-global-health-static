---
import { companyProfile } from "../data/company";
import { navigation as enNavigation } from "../i18n/en";
import { navigation as jaNavigation } from "../i18n/ja";
import { pagePath, supportedLanguages, type Lang } from "../lib/i18n";
import MobileNav from "./MobileNav.astro";

const { lang, pathname } = Astro.props as { lang: Lang; pathname: string };
const navigation = lang === "en" ? enNavigation : jaNavigation;
---

<header class="site-header">
  <a class="brand" href={`/${lang}/`} aria-label={companyProfile.name}>
    <img src="/assets/csi-mark.png" alt="" />
    <span>
      <strong>{companyProfile.name}</strong>
      <small>{companyProfile.tagline[lang]}</small>
    </span>
  </a>

  <nav class="site-nav site-nav--desktop" aria-label="Primary navigation">
    {navigation.map(([label, href]) => <a class:list={{ active: pathname === href }} href={href}>{label}</a>)}
  </nav>

  <nav class="language-switcher" aria-label="Language switcher">
    {supportedLanguages.map((target) => (
      <a aria-current={target === lang ? "page" : undefined} href={pagePath(target, pathname)}>{target.toUpperCase()}</a>
    ))}
  </nav>

  <MobileNav lang={lang} pathname={pathname} />
</header>
