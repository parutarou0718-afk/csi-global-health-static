---
import { home, type Lang } from "../data/site";

const { lang } = Astro.props as { lang: Lang };
const t = home[lang];
const copy = {
  ja: { japan: "日本（岡山）", usa: "米国（ボストン）", partners: "グローバル・パートナーネットワーク", hub: "大学研究・トランスレーション拠点", research: "AtherOx® / 心血管バイオマーカー研究", collaboration: "Europe / USA / Japan / China / Asia" },
  en: { japan: "Japan (Okayama)", usa: "United States", partners: "Global Partner Network", hub: "University research & translation hub", research: "AtherOx® / cardiovascular biomarker research", collaboration: "Europe / USA / Japan / China / Asia" },
  zh: { japan: "日本（冈山）", usa: "美国", partners: "全球合作伙伴网络", hub: "大学研究与转化中心", research: "AtherOx® / 心血管生物标志物研究", collaboration: "欧洲 / 美国 / 日本 / 中国 / 亚洲" }
}[lang];
---

<section class="section network-section">
  <div class="section-heading">
    <span>CONNECTED SCIENCE</span>
    <h2 class="section-title">{t.globalTitle}</h2>
  </div>
  <div class="network-card">
    <article class="network-hub network-brand japan-hub">
      <div class="network-brandmarks"><img src="/assets/csi-mark.png" alt="CSI Global Health" /><img src="/assets/okayama-university.svg" alt="Okayama University" /></div>
      <h3>{copy.japan}</h3><b>CSI Global Health, Co., Ltd.</b><p>{copy.hub}</p>
    </article>
    <div class="network-line" aria-hidden="true"><span>⟶</span></div>
    <article class="network-hub network-brand usa-hub">
      <div class="atherox-wordmark">Ather<span>Ox</span><sup>®</sup></div>
      <h3>{copy.usa}</h3><b>Cardiovascular Solutions and Innovations, LLC</b><p>{copy.research}</p>
    </article>
    <div class="network-line" aria-hidden="true"><span>⟶</span></div>
    <article class="network-hub global-hub">
      <div class="network-orbit" aria-hidden="true">◎</div>
      <h3>{copy.partners}</h3><p>{copy.collaboration}</p>
    </article>
  </div>
</section>
