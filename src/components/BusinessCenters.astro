---
import { home, type Lang } from "../data/site";

const { lang } = Astro.props as { lang: Lang };
const t = home[lang];
const visuals = {
  ja: { bnct: "BNCT細胞研究の抽象イメージ", atherox: "心血管バイオマーカー研究の抽象イメージ" },
  en: { bnct: "Abstract BNCT cellular research visualization", atherox: "Abstract cardiometabolic biomarker research visualization" },
  zh: { bnct: "BNCT细胞研究抽象图", atherox: "心血管生物标志物研究抽象图" }
}[lang];
---

<section class="section centers-section">
  <div class="section-heading">
    <span>RESEARCH PLATFORMS</span>
    <h2 class="section-title">{t.centersTitle}</h2>
  </div>
  <div class="dual-centers">
    <article class="center-card bnct">
      <div class="center-copy">
        <span class="kicker">01 / JAPAN</span>
        <h3>BNCT</h3>
        <h4>{t.bnctSub}</h4>
        <p>{t.bnctText}</p>
        <a class="btn red" href={`/${lang}/bnct/`}>BNCT {t.view} <span aria-hidden="true">→</span></a>
      </div>
      <figure class="science-visual">
        <picture>
          <source srcset="/assets/bnct-cellular-network.webp" type="image/webp" />
          <img src="/assets/bnct-cellular-network.png" alt={visuals.bnct} loading="lazy" width="1536" height="1024" />
        </picture>
      </figure>
    </article>
    <article class="center-card atherox">
      <div class="center-copy">
        <span class="kicker">02 / USA</span>
        <h3>AtherOx<sup>®</sup></h3>
        <h4>{t.atheroxSub}</h4>
        <p>{t.atheroxText}</p>
        <a class="btn blue" href={`/${lang}/atherox/`}>AtherOx<sup>®</sup> {t.view} <span aria-hidden="true">→</span></a>
      </div>
      <figure class="science-visual">
        <picture>
          <source srcset="/assets/atherox-biomarker-network.webp" type="image/webp" />
          <img src="/assets/atherox-biomarker-network.png" alt={visuals.atherox} loading="lazy" width="1536" height="1024" />
        </picture>
      </figure>
    </article>
  </div>
</section>
