---
import NewsArticlePage from "../../../components/NewsArticlePage.astro";
import { newsItems } from "../../../data/news";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return newsItems.map((item) => ({ params: { slug: item.slug } }));
}

const item = newsItems.find((entry) => entry.slug === Astro.params.slug);
if (!item) throw new Error("Unknown news item");
---
<BaseLayout lang="en" title={`${item.title.en} | CSI Global Health`} description={item.summary.en}>
  <NewsArticlePage lang="en" item={item} />
</BaseLayout>
